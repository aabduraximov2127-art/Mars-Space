# Local development (no Docker). Copy to backend/.env.
# `scripts/devdb.ps1 init` prints a ready DATABASE_URL for the project-local PostgreSQL cluster.
DEBUG=True
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://educentr:password@127.0.0.1:5433/educentr
FRONTEND_URL=http://localhost:5173
API_DOCS_PUBLIC=True
COOKIE_SECURE=False
# Optional: separate test database name (useful when several test runs share one server)
# TEST_DB_NAME=test_educentr
