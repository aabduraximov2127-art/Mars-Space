# =====================================================================================
# EduCentr environment template.  Copy to `.env` (Docker) and fill in real values.
# Never commit the real `.env`.  Local development without Docker uses backend/.env
# (see backend/.env.example and README "Local development").
# =====================================================================================

# --- Django core ---------------------------------------------------------------------
DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Optional separate key for JWT signing (defaults to SECRET_KEY)
JWT_SIGNING_KEY=
ALLOWED_HOSTS=edu.example.uz
CSRF_TRUSTED_ORIGINS=https://edu.example.uz
# Public URL of the web app (used in password-reset emails)
FRONTEND_URL=https://edu.example.uz
# Only needed if the SPA is served from a different origin than the API
CORS_ALLOWED_ORIGINS=

# --- Database (docker compose builds DATABASE_URL from these) -----------------------------
POSTGRES_DB=educentr
POSTGRES_USER=educentr
# URL-safe characters only (letters, digits, - _ .)
POSTGRES_PASSWORD=change-me-strong-password
# Outside Docker set it directly:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- HTTPS / cookies -----------------------------------------------------------------
# Keep True in production behind HTTPS. For a plain-HTTP local docker run set both to False.
SECURE_SSL_REDIRECT=True
COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Host port for the web container (use 8080 when a host-level TLS proxy owns port 80)
HTTP_PORT=80

# --- API docs ------------------------------------------------------------------------
# False: /api/docs/ only for staff logged into /django-admin/
API_DOCS_PUBLIC=False

# --- Email (password reset). Until SMTP is configured, mails are only printed to logs. ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EduCentr <no-reply@example.uz>

# --- Security tuning (defaults shown) ----------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_LOGIN=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_CHAT_MESSAGE=30/min

# --- Misc ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Run `migrate` automatically when the backend container starts
RUN_MIGRATIONS=1
